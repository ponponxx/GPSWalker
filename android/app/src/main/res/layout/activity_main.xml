<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="#DFFFFFFF"
        android:fontFamily="monospace"
        android:maxWidth="260dp"
        android:padding="8dp"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_settings_circle"
        android:elevation="8dp"
        android:text="⚙"
        android:textColor="#222222"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/selected_point"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="76dp"
        android:background="#EFFFFFFF"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:text="點擊地圖選擇位置"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="#F5FFFFFF"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btn_move_selected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="移動"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_fly_selected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="飛到"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_add_waypoint"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="加點"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_start_route"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="路徑"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_stop_clear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#C0392B"
            android:text="停止"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
