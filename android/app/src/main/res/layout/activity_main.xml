<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="GPSWalker"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F2F5"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textSize="13sp" />

        <com.gpswalker.companion.TouchMapView
            android:id="@+id/touch_map"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btn_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Grant location permissions" />

        <Button
            android:id="@+id/btn_dev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Developer Options" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start service" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#C0392B"
                android:text="Stop service" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="Speed"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="km/h"
            android:inputType="numberDecimal"
            android:text="4.5" />

        <Button
            android:id="@+id/btn_apply_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply speed" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="Current position / teleport"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_lat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="lat"
                android:inputType="numberDecimal|numberSigned"
                android:text="25.033000" />

            <EditText
                android:id="@+id/input_lon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="lon"
                android:inputType="numberDecimal|numberSigned"
                android:text="121.565400" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_teleport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teleport to coordinates" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="Walk to target"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_target_lat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="target lat"
                android:inputType="numberDecimal|numberSigned" />

            <EditText
                android:id="@+id/input_target_lon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="target lon"
                android:inputType="numberDecimal|numberSigned" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_walk_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start walking to target" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="Multi-point route"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_route"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:hint="One point per line: 25.033,121.5654"
            android:inputType="textMultiLine"
            android:singleLine="false" />

        <Button
            android:id="@+id/btn_walk_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start route" />

        <Button
            android:id="@+id/btn_stop_motion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#C0392B"
            android:text="STOP motion" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Setup: Android Developer Options > Select mock location app > GPSWalker. Then tap Start service."
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
